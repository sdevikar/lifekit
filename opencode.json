{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "serena": {
        "type": "local",
        "command": [
          "/home/swapnil/.local/bin/serena",
          "start-mcp-server",
          "--context",
          "ide",
          "--project-from-cwd",
          "--open-web-dashboard",
          "False"
        ],
        "disabled": true
      },
      "playwright": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "@playwright/mcp@latest"
        ]
      },
      "trace": {
        "type": "local",
        "command": [
          "/home/swapnil/.trace/bin/trace",
          "serve"
        ]
      }
    }
  }
}
