{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "serena": {
        "type": "local",
        "command": [
          "/home/swapnil/.local/bin/serena",
          "start-mcp-server",
          "--context",
          "ide",
          "--project-from-cwd",
          "--open-web-dashboard",
          "False"
        ],
        "disabled": false
      },
      "playwright": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "@playwright/mcp@latest"
        ]
      },
      "trace": {
        "type": "local",
        "command": [
          "/home/swapnil/.trace/bin/trace",
          "serve"
        ]
      },
      "rea": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "rea-agents@6.4.0",
          "mcp"
        ],
        "environment": {
          "HOPPER_LAUNCHER_PATH": "/opt/hopper/bin/Hopper"
        }
      }
    }
  },
  "plugins": [
    "superpowers@git+https://github.com/obra/superpowers.git",
    "@dietrichgebert/ponytail",
    "git+file:///home/swapnil/workspace/projects/sdlc-tools"
  ]
}
